
@article{wolfinger1997,
	title = {Two {Taylor}-series approximation methods for nonlinear mixed models},
	volume = {25},
	copyright = {https://www.elsevier.com/tdm/userlicense/1.0/},
	issn = {01679473},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0167947397000121},
	doi = {10.1016/S0167-9473(97)00012-1},
	abstract = {This paper considers a general class of nonlinear mixed models (NLMMs). In view of the often difficult numerical integrations involved in a full likelihood analysis of general NLMMs, we discuss two approximate inference procedures, both based on Taylor-series approximations to the integrated likelihood. The two methods differ in the Taylor-series expansion point for the random-effects parameters: the first method expands around zero (the expected value of the random effects) and the second around their empirical best linear unbiased predictors (EBLLPs). Wc present new algorithms for implementing both approximations and relate them to existing algorithms. Finally, wc assess the pertbrmancc of both methods through simulation, and conclude that the EBLUP-expansion method offers minor gains in accuracy over the zero-expansion method at the cost of higher computing times and instability. 1997 Elsevier Science B.V.},
	language = {en},
	number = {4},
	urldate = {2026-03-20},
	journal = {Computational Statistics \& Data Analysis},
	author = {Wolfinger, Russell D. and {Xihong Lin}},
	month = sep,
	year = {1997},
	pages = {465--490},
}
